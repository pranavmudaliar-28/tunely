# Copy to .env. Local defaults match docker-compose.yml.
DATABASE_URL=postgres://tunely:tunely@localhost:5433/tunely
TEST_DATABASE_URL=postgres://tunely:tunely@localhost:5433/tunely_test
REDIS_URL=redis://localhost:6379
API_PORT=4000
# Bearer token for /v1/admin/* until Better Auth lands (Phase 5). Use a long random string.
ADMIN_TOKEN=change-me
# Secret mixed into the daily-rotating hash for playback report de-duplication.
REPORT_HASH_SECRET=change-me
# Base URL of the API as seen by the web app (server and browser).
NEXT_PUBLIC_API_URL=http://localhost:4000
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Browser origins allowed to call the API (comma separated). Defaults to NEXT_PUBLIC_SITE_URL.
CORS_ORIGINS=http://localhost:3000
# true when the API runs behind Cloudflare or another proxy that sets X-Forwarded-For.
TRUST_PROXY=false
