# Copy to .env. Local defaults match docker-compose.yml.
DATABASE_URL=postgres://tunely:tunely@localhost:5433/tunely
TEST_DATABASE_URL=postgres://tunely:tunely@localhost:5433/tunely_test
REDIS_URL=redis://localhost:6379
API_PORT=4000
# Bearer token for /v1/admin/* until Better Auth lands (Phase 5). Use a long random string.
ADMIN_TOKEN=change-me
# Secret mixed into the daily-rotating hash for playback report de-duplication.
REPORT_HASH_SECRET=change-me
# Base URL of the API as seen by the web app (server and browser).
NEXT_PUBLIC_API_URL=http://localhost:4000
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Browser origins allowed to call the API (comma separated). Defaults to NEXT_PUBLIC_SITE_URL.
CORS_ORIGINS=http://localhost:3000
# true when the API runs behind Cloudflare or another proxy that sets X-Forwarded-For.
TRUST_PROXY=false

# Google AdSense. Leave empty to show no ads. Publisher id from the AdSense dashboard (ca-pub-…).
NEXT_PUBLIC_ADSENSE_CLIENT=
# Display ad unit id(s) (AdSense → Ads → By ad unit). One shared unit, or one per placement.
NEXT_PUBLIC_ADSENSE_SLOT=
NEXT_PUBLIC_ADSENSE_SLOT_HOME=
NEXT_PUBLIC_ADSENSE_SLOT_BROWSE=
NEXT_PUBLIC_ADSENSE_SLOT_WATCH=
# Google Search Console: the content value of the HTML-tag verification method (not the whole tag).
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=

# Adsterra banners, shown only while AdSense isn't configured (Adsterra → Websites → Banner → Get code:
# the 'key' value). One key per size; set either or both.
NEXT_PUBLIC_ADSTERRA_KEY_728X90=
NEXT_PUBLIC_ADSTERRA_KEY_320X50=
# The banner code's <script src> with the key replaced by {key}, e.g. https://bauval.org/22/{key}.
# Defaults to https://www.highperformanceformat.com/{key}/invoke.js.
NEXT_PUBLIC_ADSTERRA_SCRIPT=

# Donation page (https://, e.g. Buy Me a Coffee, Ko-fi, Razorpay). Shows a Support link in the footer.
NEXT_PUBLIC_SUPPORT_URL=
# Affiliate links on /watch-on-tv. Amazon Associates tracking id and its store (default amazon.in).
NEXT_PUBLIC_AMAZON_TAG=
NEXT_PUBLIC_AMAZON_DOMAIN=
NEXT_PUBLIC_VPN_AFFILIATE_URL=
NEXT_PUBLIC_VPN_NAME=

# Worker pacing (optional; defaults suit an always-on server). Free hosting with Neon uses slower values, see render.yaml.
# HEALTH_BATCH_EVERY_MIN=15
# HEALTH_BATCH_SIZE=1000
# RECHECK_AFTER_HOURS=4
# HEALTH_SCORE_EVERY_MIN=60
# CHECKS_RETENTION_DAYS=30
