{
  "name": "@tunely/api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=../../.env src/index.ts",
    "build": "node ../../scripts/bundle.mjs src/index.ts src/migrate.ts",
    "start": "node --env-file-if-exists=../../.env --enable-source-maps dist/index.js",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "bench": "tsx --env-file-if-exists=../../.env scripts/bench.ts"
  },
  "dependencies": {
    "@fastify/cors": "11.3.1",
    "@fastify/rate-limit": "11.2.1",
    "@fastify/swagger": "9.9.2",
    "@fastify/swagger-ui": "6.1.2",
    "@tunely/db": "workspace:*",
    "@tunely/shared": "workspace:*",
    "bullmq": "6.5.0",
    "drizzle-orm": "0.45.4",
    "fastify": "5.12.7",
    "fastify-type-provider-zod": "7.0.0",
    "ioredis": "6.0.0",
    "zod": "4.6.7",
    "pg": "8.23.1"
  },
  "devDependencies": {
    "@tunely/config": "workspace:*",
    "@types/node": "26.6.5",
    "esbuild": "0.28.2",
    "eslint": "10.13.0",
    "pino-pretty": "13.2.0",
    "tsx": "4.23.15",
    "typescript": "6.0.3",
    "vitest": "5.0.5"
  }
}
