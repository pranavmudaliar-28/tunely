{
  "name": "@tunely/worker",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=../../.env src/index.ts",
    "build": "esbuild src/index.ts --bundle --platform=node --format=esm --target=node22 --packages=external --outfile=dist/index.js",
    "start": "node --env-file-if-exists=../../.env dist/index.js",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "sync:once": "tsx --env-file-if-exists=../../.env scripts/sync-once.ts",
    "curate": "tsx --env-file-if-exists=../../.env scripts/curate.ts",
    "health:once": "tsx --env-file-if-exists=../../.env scripts/health-once.ts"
  },
  "dependencies": {
    "@tunely/db": "workspace:*",
    "@tunely/shared": "workspace:*",
    "bullmq": "6.5.0",
    "drizzle-orm": "0.45.4",
    "ioredis": "6.0.0",
    "ipaddr.js": "2.5.0",
    "pino": "10.4.0",
    "undici": "8.12.3",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@tunely/config": "workspace:*",
    "@types/node": "26.6.5",
    "esbuild": "0.28.2",
    "eslint": "10.13.0",
    "tsx": "4.23.15",
    "typescript": "6.0.3",
    "vitest": "5.0.5"
  }
}
